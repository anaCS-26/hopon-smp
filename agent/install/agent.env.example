# /etc/mc-agent/agent.env  (root:root 0644). Not secret. Secrets live in separate 0600 files:
#   /etc/mc-agent/hmac-keys        kid:base64key   (shared with Vercel as AGENT_KEY_ID / AGENT_HMAC_KEY)
#   /etc/mc-agent/discord-webhook  optional Discord webhook URL (empty file = off)

AGENT_LISTEN=127.0.0.1:8787
AGENT_DATA_DIR=/var/lib/mc-agent

# The Tailscale Funnel URL of this VM (see README). Used for resource-pack links and uploads.
AGENT_PUBLIC_URL=https://REPLACE-machine.REPLACE-tailnet.ts.net

# Your dashboard's address on Vercel (CORS for resource-pack uploads).
DASHBOARD_ORIGIN=https://REPLACE.vercel.app

# Your Discord user id (Discord: Settings -> Advanced -> Developer Mode, then right-click yourself -> Copy User ID).
# The first login with this id becomes the Team Leader.
OWNER_DISCORD_ID=REPLACE

JOIN_ADDRESS=hopon-smp.duckdns.org
