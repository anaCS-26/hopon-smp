# Copy to .env.mock for `npm run mock`. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The dashboard's dashboard/.env.local must use the same key (AGENT_HMAC_KEY) and key id (AGENT_KEY_ID=dev).
AGENT_HMAC_KEYS=dev:REPLACE_WITH_BASE64_32_BYTES
AGENT_LISTEN=127.0.0.1:8787
DASHBOARD_ORIGIN=http://localhost:3000
MOCK_SPEED=1
