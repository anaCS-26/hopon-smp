# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these in Project Settings -> Environment Variables instead.

# --- Agent (the control API on the VM, or the local mock agent) ---
# Server-side URL the dashboard calls. Local mock: http://127.0.0.1:8787
AGENT_URL=http://127.0.0.1:8787
# Public URL browsers use for direct resource-pack uploads (same as AGENT_URL in production: the Funnel URL).
NEXT_PUBLIC_AGENT_UPLOAD_ORIGIN=http://127.0.0.1:8787
# Must match one entry in the agent's AGENT_HMAC_KEYS (kid:base64key).
AGENT_KEY_ID=dev
AGENT_HMAC_KEY=REPLACE_WITH_THE_SAME_BASE64_KEY_AS_THE_AGENT

# --- Sessions ---
# 32+ random bytes, base64. Vercel only. Changing it logs everyone out.
SESSION_SECRET=REPLACE_WITH_BASE64_32_BYTES

# --- Discord login (https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must be listed under OAuth2 -> Redirects in the Discord app, exactly.
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- Local development only: "log in as" a mock user without Discord ---
# Ignored unless NODE_ENV=development and not running on Vercel.
HOPON_DEV_LOGIN=1
