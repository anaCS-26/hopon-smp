[Unit]
Description=Minecraft server console input (named pipe)
# Created and removed together with the server, so commands can never queue up
# while the server is stopped and then run on the next start.
PartOf=minecraft.service

[Socket]
ListenFIFO=/run/minecraft.console
SocketUser=minecraft
SocketGroup=minecraft
SocketMode=0660
RemoveOnStop=true
# PartOf= only removes the pipe on a deliberate stop/restart. When the server exits on its own
# (crash, or "stop" typed in the console) the pipe stays, so throw away anything still queued
# in it. Otherwise leftover input (e.g. a "stop") would be read by the next start, or would
# even start the server again by itself (this socket starts minecraft.service when written to).
FlushPending=true
